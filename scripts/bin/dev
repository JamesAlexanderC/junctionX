#!/usr/bin/env bash
# Run the whole app locally: Postgres (docker), migrations, Django on :8000
# and the Vite dev server on :5173 (which proxies /api to Django).
#
# Usage: scripts/bin/dev [--sqlite] [--demo] [--backend-only | --frontend-only]
#   --sqlite          use backend/db.sqlite3 instead of Postgres (no docker)
#   --demo            serve Django with gunicorn (several workers, no reload,
#                     DEBUG off) instead of the single-threaded dev server
#   --backend-only    only run Django
#   --frontend-only   only run Vite (falls back to demo data without the API)
#
# Ctrl-C stops both servers.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

# --demo: 4 workers x 2 threads served 50 customers loading at once; the
# timeout covers slow Gemini turns (gunicorn's default of 30 s cuts them off).
DEMO_WORKERS=4
DEMO_THREADS=2
DEMO_TIMEOUT_S=120

SQLITE=0
DEMO=0
DO_BACKEND=1
DO_FRONTEND=1
for arg in "$@"; do
    case "${arg}" in
        --sqlite) SQLITE=1 ;;
        --demo) DEMO=1 ;;
        --backend-only) DO_FRONTEND=0 ;;
        --frontend-only) DO_BACKEND=0 ;;
        -h|--help)
            sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "Unknown argument: ${arg}" >&2
            exit 1
            ;;
    esac
done

PY="${REPO_ROOT}/.venv/bin/python"
[ -x "${PY}" ] || PY="${REPO_ROOT}/venv/bin/python"
if [ "${DO_BACKEND}" -eq 1 ] && [ ! -x "${PY}" ]; then
    echo "No virtualenv found. Run 'setup' first." >&2
    exit 1
fi

pids=()
cleanup() {
    for pid in "${pids[@]:-}"; do
        [ -n "${pid}" ] && kill "${pid}" 2>/dev/null || true
    done
}
trap cleanup EXIT INT TERM

if [ "${DO_BACKEND}" -eq 1 ]; then
    if [ "${SQLITE}" -eq 1 ]; then
        export USE_SQLITE=1
    else
        echo "==> Starting Postgres (docker compose)"
        (cd "${REPO_ROOT}" && docker compose up -d --wait db)
    fi
    echo "==> Applying migrations"
    # Debug on: with DJANGO_DEBUG=0 settings refuse to load without a real
    # DJANGO_SECRET_KEY, and migrating locally needs neither.
    (cd "${REPO_ROOT}/backend" && DJANGO_DEBUG=1 "${PY}" manage.py migrate --noinput)
    if [ "${DEMO}" -eq 1 ]; then
        echo "==> Django (gunicorn, ${DEMO_WORKERS} workers) on http://localhost:8000"
        (cd "${REPO_ROOT}/backend" && DJANGO_DEBUG=0 exec "${PY}" -m gunicorn \
            conf.wsgi:application --bind 127.0.0.1:8000 \
            --workers "${DEMO_WORKERS}" --threads "${DEMO_THREADS}" \
            --timeout "${DEMO_TIMEOUT_S}") &
    else
        echo "==> Django on http://localhost:8000 (API docs at /api/docs/)"
        # Local dev server: debug on (off needs a real DJANGO_SECRET_KEY).
        (cd "${REPO_ROOT}/backend" && DJANGO_DEBUG=1 exec "${PY}" manage.py \
            runserver 8000) &
    fi
    pids+=("$!")
fi

if [ "${DO_FRONTEND}" -eq 1 ]; then
    if [ ! -d "${REPO_ROOT}/frontend/node_modules" ]; then
        echo "No frontend/node_modules. Run 'setup --frontend-only' first." >&2
        exit 1
    fi
    echo "==> Vite on http://localhost:5173"
    (cd "${REPO_ROOT}/frontend" && exec npm run dev -- --port 5173) &
    pids+=("$!")
fi

wait
