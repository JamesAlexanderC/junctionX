#!/usr/bin/env bash
# Build the production images (backend: gunicorn, frontend: Caddy).
#
# Usage: scripts/bin/docker-build [--no-cache] [service...]
#   --no-cache   rebuild every layer from scratch
#   service      only build these (backend, frontend)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

ARGS=()
for arg in "$@"; do
    case "${arg}" in
        --no-cache) ARGS+=(--no-cache) ;;
        -h|--help)
            sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        -*)
            echo "Unknown argument: ${arg}" >&2
            exit 1
            ;;
        *) ARGS+=("${arg}") ;;
    esac
done

cd "${REPO_ROOT}"
docker compose -f docker-compose.prod.yml build ${ARGS[@]+"${ARGS[@]}"}
