# Postgres (shared with docker-compose.yml)
POSTGRES_USER=USER
POSTGRES_PASSWORD=**CHANGE_ME**
POSTGRES_DB=DB
POSTGRES_PORT=5432

# Gemini (never commit a real key). Empty = offline canned chat replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
# Thinking for what-ifs and plans (depth 3-4): low or high; empty = model
# default. Depth 1 never thinks, depth 2 thinks low.
GEMINI_THINKING_LEVEL=
# 1 = show the headings of Gemini's thought summaries while a reply loads.
GEMINI_SHOW_THOUGHTS=1

# 1 = Django debug pages and the fallback "debug" field in chat replies.
# Leave 0 for a demo: debug 404 pages list every URL route.
DJANGO_DEBUG=0

# 1 = answer scripted demo questions from the cache (context.md P2.6)
DEMO_MODE=1

# Folder with the S-Bank CSVs, relative to the repo root
DATA_DIR=data/dataset/Junction-2026-S-pankki
# Comma-separated customer ids kept by `manage.py load_data`
DEMO_CUSTOMERS=

# Production (docker-compose.prod.yml). Dev defaults apply when unset.
DJANGO_SECRET_KEY=**CHANGE_ME**
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Caddy: ":80" = plain HTTP; a domain name turns on automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
